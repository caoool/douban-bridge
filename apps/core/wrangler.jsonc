{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "douban-bridge-core",
  "main": "./src/index.tsx",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "workers_dev": true,
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "STREMIO_ADDON_DOUBAN",
      "database_name": "douban-bridge",
      "database_id": "1cfc8e1c-f772-4d2a-af98-4ac30e56a3ef",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1c01f9ab2211436085db103f3257b426",
      "remote": false
    }
  ],
  "vars": {
    "DOUBAN_API_KEY": "0ac44ae016490db2204ce0a042db2916",
    "STREMIO_ORIGIN": "https://douban-stremio-plugin.caoool.workers.dev",
    "DASH_ORIGIN": "https://douban-bridge-core.caoool.workers.dev",
    "AGENT_MATCH_GATEWAY_ID": "douban-bridge",
    "AGENT_MATCH_GATEWAY_PROVIDER": "",
    "AGENT_MATCH_ENABLED": "false",
    "TOKENS_REPORT_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "USER_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "AGENT_MATCH_QUEUE",
        "queue": "douban-agent-match"
      }
    ],
    "consumers": [
      {
        "queue": "douban-agent-match",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "account_id": "4d1a9be94de7e6080ddebc5ad5b2df9b",
  "secrets": {
    "required": ["JWT_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "TMDB_API_KEY", "TRAKT_CLIENT_ID"]
  }
}
