{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "douban-stremio-plugin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8788
  },
  "services": [
    {
      "binding": "CORE_STREMIO",
      "service": "douban-bridge-core",
      "entrypoint": "StremioEntrypoint",
      "remote": false
    },
    {
      "binding": "CORE_WEB",
      "service": "douban-bridge-core",
      "remote": false
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "USER_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "account_id": "4d1a9be94de7e6080ddebc5ad5b2df9b",
  "workers_dev": true
}
